# Скопируйте этот файл в `.env.local` и подставьте свой ключ.
# `.env.local` в git не попадает — ключ остаётся только на вашей машине и на сервере.

# Ключ FASHN AI: https://app.fashn.ai -> Settings -> API.
# Без ключа сайт работает в демо-режиме (заглушка с водяным знаком).
FASHN_API_KEY=

# --- необязательные настройки (можно не трогать) ---

# Модель примерки. tryon-v1.6 — быстрая, tryon-max — качественнее и медленнее.
# FASHN_MODEL=tryon-v1.6

# Ограничение: сколько примерок разрешено с одного IP за окно времени.
# RATE_LIMIT_MAX=6
# RATE_LIMIT_WINDOW_MS=60000

# Максимальное время ожидания одной генерации, мс.
# TRYON_TIMEOUT_MS=55000
